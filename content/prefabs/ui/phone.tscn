[ext_resource type="Script" path="res://scripts/ui/phone_messages_app.gd" id="3_msgapp"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_body"]
bg_color = Color(0.07, 0.07, 0.09, 0.96)
corner_radius_top_left = 24

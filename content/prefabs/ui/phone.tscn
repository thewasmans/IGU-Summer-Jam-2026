[node name="PhoneUI" type="Control" node_paths=PackedStringArray("app_name_label", "home_app", "messages_app")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_phoneui")
